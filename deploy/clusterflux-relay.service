[Unit]
Description=Clusterflux self-hosted Iroh relay
After=network-online.target clusterflux-coordinator.service
Wants=network-online.target

[Service]
Type=simple
User=clusterflux
Group=clusterflux
EnvironmentFile=/etc/clusterflux/clusterflux.env
Environment=CLUSTERFLUX_RELAY_ACCESS_MODE=callback
Environment=CLUSTERFLUX_RELAY_ACCESS_CALLBACK_URL=http://127.0.0.1:7998/internal/relay/authorize
Environment=CLUSTERFLUX_RELAY_BIND=127.0.0.1:3340
Environment=CLUSTERFLUX_RELAY_METRICS_BIND=127.0.0.1:9091
Environment=CLUSTERFLUX_RELAY_MAX_CONNECTIONS=4096
Environment=CLUSTERFLUX_RELAY_MAX_CONNECTIONS_PER_ENDPOINT=4
Environment=CLUSTERFLUX_RELAY_MAX_CONNECTIONS_PER_TENANT=128
Environment=CLUSTERFLUX_RELAY_BYTES_PER_SECOND=134217728
Environment=CLUSTERFLUX_RELAY_BURST_BYTES=8388608
Environment=CLUSTERFLUX_RELAY_CALLBACK_TIMEOUT_MS=750
Environment=CLUSTERFLUX_RELAY_CALLBACK_WORKERS=32
Environment=CLUSTERFLUX_RELAY_CALLBACK_WORKERS_PER_TENANT=4
Environment=CLUSTERFLUX_RELAY_UNKNOWN_ENDPOINT_CALLBACK_WORKERS=8
Environment=CLUSTERFLUX_RELAY_POSITIVE_CACHE_MS=1000
Environment=CLUSTERFLUX_RELAY_REAUTHORIZE_INTERVAL_MS=1000
ExecStart=/usr/bin/clusterflux-relay
Restart=always
RestartSec=5s
MemoryHigh=768M
MemoryMax=1G
LimitNOFILE=16384
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
