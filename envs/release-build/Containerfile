# syntax=docker/dockerfile:1
FROM rust:1.91.1-bookworm AS rust

FROM node:22.17.0-bookworm-slim
ARG NFPM_VERSION=2.47.0
ARG NFPM_DEB_SHA256=3f1cf344bd0b57373ca55636a78c08b0491f7293d609a456a9ac3b0b150fda97
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:${PATH} \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git gzip jq libssl-dev pkg-config rpm tar unzip \
 && curl -fsSL "https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_amd64.deb" \
      -o /tmp/nfpm.deb \
 && echo "${NFPM_DEB_SHA256}  /tmp/nfpm.deb" | sha256sum -c - \
 && dpkg -i /tmp/nfpm.deb \
 && rm -f /tmp/nfpm.deb \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add wasm32-unknown-unknown \
 && rustc --version | grep -F '1.91.1' \
 && node --version | grep -F 'v22.17.0' \
 && jq --version \
 && unzip -v | head -n 1 \
 && nfpm --version | grep -F '2.47.0'
WORKDIR /workspace
