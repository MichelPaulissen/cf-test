param(
    [string]$Prefix = (Join-Path $env:LOCALAPPDATA 'Clusterflux'),
    [string]$ReleaseTag = $(if ($env:CLUSTERFLUX_RELEASE_TAG) { $env:CLUSTERFLUX_RELEASE_TAG } else { '@RELEASE_TAG@' }),
    [string]$DownloadUri = '',
    [switch]$NoPathUpdate,
    [switch]$NoFirewallUpdate
)

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
Set-StrictMode -Version Latest

$expectedVersion = '@VERSION@'
$expectedDigest = '@WINDOWS_ARCHIVE_SHA256@'
$archiveName = 'clusterflux-windows-x86_64.zip'
$machineArchitecture = if ($env:PROCESSOR_ARCHITEW6432) {
    $env:PROCESSOR_ARCHITEW6432
} else {
    $env:PROCESSOR_ARCHITECTURE
}
if (-not [Environment]::Is64BitOperatingSystem -or $machineArchitecture -ne 'AMD64') {
    throw 'Clusterflux requires Windows x86-64'
}
if ($ReleaseTag -cnotmatch '^(v[0-9]+\.[0-9]+\.[0-9]+|build-[0-9a-f]{12})$') {
    throw 'release tag is malformed'
}
if ([string]::IsNullOrWhiteSpace($DownloadUri)) {
    $DownloadUri = "https://github.com/lesstuff/clusterflux/releases/download/$ReleaseTag/$archiveName"
}

$prefixPath = [IO.Path]::GetFullPath($Prefix)
$parent = Split-Path -Parent $prefixPath
if ([string]::IsNullOrWhiteSpace($parent)) { throw 'installation prefix must have a parent directory' }
[IO.Directory]::CreateDirectory($parent) | Out-Null
$nonce = "$PID-$([Guid]::NewGuid().ToString('N'))"
$downloadRoot = Join-Path ([IO.Path]::GetTempPath()) "clusterflux-download-$nonce"
$archive = Join-Path $downloadRoot $archiveName
$staging = "$prefixPath.new-$nonce"
$backup = "$prefixPath.previous-$nonce"
$oldMoved = $false

try {
    [IO.Directory]::CreateDirectory($downloadRoot) | Out-Null
    Invoke-WebRequest -UseBasicParsing -Uri $DownloadUri -OutFile $archive
    $actualDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath $archive).Hash.ToLowerInvariant()
    if ($actualDigest -cne $expectedDigest) {
        throw "Windows package digest mismatch: expected $expectedDigest, found $actualDigest"
    }

    Expand-Archive -LiteralPath $archive -DestinationPath $staging
    $required = @(
        'LICENSE-APACHE',
        'LICENSE-MIT',
        'README-install.txt',
        'clusterflux-environment-setup.exe',
        'clusterflux-node.exe',
        'package-manifest.json'
    )
    $actualNames = @(Get-ChildItem -LiteralPath $staging -File | ForEach-Object Name | Sort-Object)
    if (($actualNames -join "`n") -cne (($required | Sort-Object) -join "`n")) {
        throw 'Windows package contains an unexpected file layout'
    }
    $manifest = Get-Content -LiteralPath (Join-Path $staging 'package-manifest.json') -Raw | ConvertFrom-Json
    if ($manifest.format_version -ne 1 -or
        $manifest.kind -cne 'clusterflux-windows-package' -or
        $manifest.version -cne $expectedVersion -or
        $manifest.architecture -cne 'x86_64-windows') {
        throw 'Windows package manifest does not match this installer'
    }
    foreach ($name in @('clusterflux-node.exe', 'clusterflux-environment-setup.exe')) {
        $binaryDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $staging $name)).Hash.ToLowerInvariant()
        $expectedBinaryDigest = $manifest.binaries.$name
        if ($expectedBinaryDigest -cne "sha256:$binaryDigest") {
            throw "Windows package binary digest mismatch for $name"
        }
    }

    $nodeVersion = (& (Join-Path $staging 'clusterflux-node.exe') --version 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0 -or $nodeVersion -notmatch [regex]::Escape($expectedVersion)) {
        throw 'clusterflux-node.exe reported the wrong version'
    }
    $setupVersion = (& (Join-Path $staging 'clusterflux-environment-setup.exe') --version 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0 -or $setupVersion -notmatch [regex]::Escape($expectedVersion)) {
        throw 'clusterflux-environment-setup.exe reported the wrong version'
    }

    if (Test-Path -LiteralPath $prefixPath) {
        Move-Item -LiteralPath $prefixPath -Destination $backup
        $oldMoved = $true
    }
    Move-Item -LiteralPath $staging -Destination $prefixPath
    if ($oldMoved) {
        Remove-Item -LiteralPath $backup -Recurse -Force
        $oldMoved = $false
    }
}
catch {
    if ($oldMoved -and -not (Test-Path -LiteralPath $prefixPath) -and (Test-Path -LiteralPath $backup)) {
        Move-Item -LiteralPath $backup -Destination $prefixPath
        $oldMoved = $false
    }
    throw
}
finally {
    if (Test-Path -LiteralPath $downloadRoot) { Remove-Item -LiteralPath $downloadRoot -Recurse -Force }
    if (Test-Path -LiteralPath $staging) { Remove-Item -LiteralPath $staging -Recurse -Force }
    if (Test-Path -LiteralPath $backup) { Remove-Item -LiteralPath $backup -Recurse -Force }
}

$userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
$pathEntries = @($userPath -split ';' | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
if (-not ($pathEntries | Where-Object { $_.TrimEnd('\') -ieq $prefixPath.TrimEnd('\') })) {
    if ($NoPathUpdate) {
        Write-Output "Add $prefixPath to your user PATH, then open a new terminal."
    } else {
        $newPath = (@($pathEntries) + $prefixPath) -join ';'
        [Environment]::SetEnvironmentVariable('Path', $newPath, 'User')
        Write-Output "Added $prefixPath to your user PATH. Open a new terminal to use it."
    }
}

$nodeProgram = Join-Path $prefixPath 'clusterflux-node.exe'
$firewallRuleName = 'ClusterfluxArtifactTransferInbound'
$isAdministrator = [Security.Principal.WindowsPrincipal]::new(
    [Security.Principal.WindowsIdentity]::GetCurrent()
).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($NoFirewallUpdate) {
    Write-Output "Windows Firewall was not changed. Allow inbound UDP for $nodeProgram before transferring artifacts."
} elseif (-not $isAdministrator) {
    Write-Output 'Windows Firewall was not changed because this PowerShell is not running as Administrator.'
    Write-Output 'Rerun this installer from an Administrator PowerShell to enable direct artifact transfer.'
} else {
    Get-NetFirewallRule -Name $firewallRuleName -ErrorAction SilentlyContinue |
        Remove-NetFirewallRule -ErrorAction Stop
    New-NetFirewallRule `
        -Name $firewallRuleName `
        -DisplayName 'Clusterflux artifact transfer' `
        -Group 'Clusterflux' `
        -Enabled True `
        -Direction Inbound `
        -Action Allow `
        -Program $nodeProgram `
        -Protocol UDP `
        -Profile Any | Out-Null
    Write-Output "Allowed authenticated Clusterflux artifact transfer through Windows Firewall for $nodeProgram."
}

Write-Output "Installed Clusterflux $expectedVersion in $prefixPath"
Write-Output 'Next, create a one-use grant from an authenticated CLI:'
Write-Output '  clusterflux node enroll --project-id <project-id> --json'
Write-Output 'Then follow docs/windows-nodes.md to materialize the environment and start clusterflux-node.exe --worker.'
